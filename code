import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
public class VehicleManagementSystem {
public static void main(String[] args) {
new LoginPage();
}
}
class LoginPage extends JFrame {
JTextField username;
JPasswordField password;
JButton loginBtn, resetBtn;
LoginPage() {
setTitle("Vehicle Management System - Login");
setSize(400, 300);
setLayout(null);
setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
setLocationRelativeTo(null);
JLabel title = new JLabel("Login Page");
title.setFont(new Font("Arial", Font.BOLD, 20));
title.setBounds(140, 20, 200, 30);
add(title);
JLabel userLabel = new JLabel("Username:");
userLabel.setBounds(50, 80, 100, 25);
add(userLabel); 
username = new JTextField();
username.setBounds(150, 80, 180, 25);
add(username);
JLabel passLabel = new JLabel("Password:");
passLabel.setBounds(50, 120, 100, 25);
add(passLabel);
password = new JPasswordField();
password.setBounds(150, 120, 180, 25);
add(password);
loginBtn = new JButton("Login");
loginBtn.setBounds(80, 180, 100, 30);
add(loginBtn);
resetBtn = new JButton("Reset");
resetBtn.setBounds(200, 180, 100, 30);
add(resetBtn);
loginBtn.addActionListener(new ActionListener() {
public void actionPerformed(ActionEvent e) {
String user = username.getText();
String pass = new String(password.getPassword());
if (user.equals("admin") && pass.equals("1234")) {
JOptionPane.showMessageDialog(null, "Login Successful!");
dispose(); // close login window
new Dashboard(); // open dashboard
} else {
JOptionPane.showMessageDialog(null, "Invalid Credentials!");
}
}
}); 
resetBtn.addActionListener(new ActionListener() {
public void actionPerformed(ActionEvent e) {
username.setText("");
password.setText("");
}
});
setVisible(true);
}
}
class Dashboard extends JFrame {
Dashboard() {
setTitle("Vehicle Management System - Dashboard");
setSize(500, 400);
setLayout(new BorderLayout());
setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
setLocationRelativeTo(null);
JLabel welcome = new JLabel("Welcome to Vehicle Management System",
JLabel.CENTER);
welcome.setFont(new Font("Arial", Font.BOLD, 18));
add(welcome, BorderLayout.CENTER);
setVisible(true);
}
